{
  "name": "forge-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "FORGE — Local-First P2P Engineering Workspace",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@forge/web",
    "dev:all": "npm run dev --workspaces",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "signaling": "node packages/collaboration/bin/signaling-server.cjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}

